# syntax=docker/dockerfile:1.7
#
# Storybook image: builds on the same ui-web package build (see Dockerfile), then captures
# the component screenshots with Playwright and serves the browsable storybook.

# Stage 1: build the package exactly like the base ui-web container (produces dist/ + assets).
FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS pkg

WORKDIR /pkg

COPY package.json package-lock.json ./
RUN npm ci
RUN npm audit --audit-level=high

COPY README.md eslint.config.js tsconfig.json vite.config.ts vite.storybook.config.ts vitest.config.ts ./
COPY assets ./assets
COPY scripts ./scripts
COPY src ./src
COPY storybook ./storybook
COPY test ./test
RUN npm run check

# Stage 2: render the storybook and capture screenshots with the matching Playwright browser.
FROM mcr.microsoft.com/playwright:v1.61.1-noble@sha256:5b8f294aff9041b7191c34a4bab3ac270157a28774d4b0660e9743297b697e48 AS capture

WORKDIR /pkg

COPY package.json package-lock.json ./
RUN npm ci
RUN npm audit --audit-level=high

COPY --from=pkg /pkg/dist ./dist
COPY --from=pkg /pkg/assets ./assets
COPY src ./src
COPY scripts ./scripts
COPY storybook ./storybook
COPY vite.storybook.config.ts ./
RUN npm run storybook:bundle && node scripts/build-storybook.mjs

# Stage 3: serve the browsable storybook (live page + screenshots gallery + offline ZIP).
FROM nginx:1.30.4-trixie@sha256:5cf90903deda2c5981b8ad05e7617ac010e389f0dde0ac83487c02c509281de6 AS serve

RUN chown -R 101:101 /var/cache/nginx /var/run

COPY --from=capture /pkg/storybook-dist /usr/share/nginx/html
COPY storybook/nginx.conf /etc/nginx/conf.d/default.conf

USER 101:101

# Optional export target for CI: `docker build --target export --output type=local,dest=out`
# writes the storybook directory and ZIP to the host without pushing an image.
FROM scratch AS export

COPY --from=capture /pkg/storybook-dist /storybook-dist
COPY --from=capture /pkg/storybook.zip /storybook.zip
